{
  "printWidth": 100,
  "proseWrap": "always",
  "tabWidth": 2,
  "overrides": [
    {
      "files": "*.yml",
      "options": { "singleQuote": false }
    },
    {
      "files": "*.yaml",
      "options": { "singleQuote": false }
    },
    {
      "files": "*.json",
      "options": { "trailingComma": "none" }
    }
  ]
}
